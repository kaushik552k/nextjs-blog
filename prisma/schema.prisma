// 1. Configuration
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER & AUTHENTICATION
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String   // Hashed
  avatar    String?  // URL to profile image
  bio       String?
  role      Role     @default(USER) // Admin vs Visitor
  
  posts     Post[]   // One author, many posts
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

// ==========================================
// BLOG POSTS (The Core)
// ==========================================

model Post {
  id          String    @id @default(uuid())
  
  // 1. Content & SEO
  title       String
  subtitle    String?   // "A visual guide to..."
  slug        String    @unique
  excerpt     String?   // Short description for cards
  
  // 2. The Body (Crucial for your mock data structure)
  // We use JSONB to store the array: [{ type: "code", ... }, { type: "callout", ... }]
  content     Json      
  
  // 3. Metadata
  coverImage  String?
  readingTime Int       // Store as Integer (minutes), format as "18 min read" on frontend
  likes       Int       @default(0)
  views       Int       @default(0)  // Track post views
  featured    Boolean   @default(false)
  published   Boolean   @default(false)
  image       String?
  // 4. Visuals (From your mock data)
  gradient    String?   // e.g. "from-violet-500 to-purple-600"
  
  // 5. Relations
  author      User      @relation(fields: [authorId], references: [id])
  authorId    String

  category    Category  @relation(fields: [categoryId], references: [id])
  categoryId  String

  // Optional: A post might belong to a specific subcategory
  subcategory SubCategory? @relation(fields: [subcategoryId], references: [id])
  subcategoryId String?

  tags        Tag[]     // Many-to-Many

  // 6. Timestamps
  publishedAt DateTime? // Nullable (if draft)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([published])
  @@index([featured])
}

// ==========================================
// TAXONOMY (Categories & Tags)
// ==========================================

model Category {
  id          String   @id @default(uuid())
  name        String   @unique // "System Design"
  slug        String   @unique // "system-design"
  description String?
  
  // Visuals for the Category Page
  gradient    String?  // "from-violet-500 to-purple-600"
  icon        String?  // "Database" (Lucide Icon Name)
  
  // Hierarchy
  subcategories SubCategory[]
  posts         Post[]

  createdAt   DateTime @default(now())
}

model SubCategory {
  id          String   @id @default(uuid())
  name        String   // "Distributed Systems"
  slug        String   // "distributed-systems"
  
  // Relation to Parent Category
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String

  posts       Post[]
  
  // Composite unique constraint: 
  // You can have "Architecture" under "System Design" AND "Web Dev" if you really wanted,
  // but usually slug should be globally unique. Let's keep slug unique.
  @@unique([slug])
}

model Tag {
  id    String @id @default(uuid())
  name  String @unique // "nextjs"
  slug  String @unique // "nextjs"
  posts Post[]
}

// ==========================================
// INTERVIEW QUESTIONS
// ==========================================

model QuestionCategory {
  id          String     @id @default(uuid())
  name        String     @unique // e.g. "Agentic AI", "Java"
  slug        String     @unique
  questions   Question[]
  createdAt   DateTime   @default(now())
}

model Question {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  answer      String   @db.Text
  difficulty  String   // "Easy", "Medium", "Hard"
  
  category    QuestionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// DATA STRUCTURES & ALGORITHMS (DSA)
// ==========================================

model DsaCategory {
  id          String         @id @default(uuid())
  name        String         @unique // e.g. "Binary Search", "Array"
  slug        String         @unique
  questions   DsaQuestion[]
  createdAt   DateTime       @default(now())
}

model DsaQuestion {
  id               String       @id @default(uuid())
  originalId       Int?         @unique // Map to the JSON id (e.g. 400)
  title            String
  slug             String       @unique
  description      String       @db.Text
  difficulty       String       // "Easy", "Medium", "Hard"
  shortAnswer      String       @db.Text
  solutionLink     String?
  learningResource String?
  tags             String
  
  // Code snippets
  pythonCode       String?      @db.Text
  javaCode         String?      @db.Text
  jsCode           String?      @db.Text
  
  category         DsaCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId       String
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}